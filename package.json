{
  "name": "photoshoot-organizer",
  "version": "1.27.0",
  "private": true,
  "scripts": {
    "devdb": "docker compose up -d db && next dev --turbopack",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "eslint src next.config.ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "format": "prettier --write .",
    "admin:grant": "node --env-file=.env scripts/admin.cjs grant",
    "admin:revoke": "node --env-file=.env scripts/admin.cjs revoke",
    "test:registration": "node scripts/test-registration.cjs",
    "db:deploy": "node scripts/migrate.cjs deploy",
    "db:baseline": "node scripts/migrate.cjs baseline",
    "test:updater": "python3 scripts/test-updater.py && python3 scripts/test-container-update.py",
    "test:migrations": "node scripts/test-migrations.cjs",
    "test:design": "node scripts/test-design.cjs",
    "test:workspace": "node scripts/test-workspace-features.cjs",
    "test:audit": "node scripts/test-project-security.cjs && node scripts/test-folder-integrity.cjs && node scripts/test-rating-controls.cjs && node scripts/test-public-loading.cjs && node scripts/test-dependency-compatibility.cjs",
    "test:audit:integration": "node scripts/test-audit-integration.cjs",
    "test:pocket-id": "node scripts/test-pocket-id.cjs"
  },
  "dependencies": {
    "@auth/core": "0.41.3",
    "@auth/prisma-adapter": "2.11.3",
    "@fullcalendar/core": "^6.1.20",
    "@fullcalendar/daygrid": "^6.1.20",
    "@fullcalendar/interaction": "^6.1.20",
    "@fullcalendar/list": "^6.1.20",
    "@fullcalendar/react": "^6.1.20",
    "@fullcalendar/timegrid": "^6.1.20",
    "@prisma/client": "6.19.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@react-pdf/renderer": "^4.2.0",
    "archiver": "^7.0.1",
    "bcryptjs": "^2.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "framer-motion": "^12.24.10",
    "jose": "6.1.3",
    "lucide-react": "^0.468.0",
    "nanoid": "^5.1.16",
    "next": "16.4.3",
    "next-auth": "^5.0.0-beta.32",
    "nodemailer": "10.1.4",
    "prisma": "6.19.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "sharp": "0.35.5",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0",
    "yet-another-react-lightbox": "^3.28.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.15",
    "@types/archiver": "^7.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/fluent-ffmpeg": "^2.1.28",
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^7.0.5",
    "@types/react": "^19.0.6",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.17.0",
    "eslint-config-next": "16.4.3",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.0"
  },
  "overrides": {
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "archiver-utils": {
      "glob": "14.0.3"
    },
    "readdir-glob": {
      "minimatch": "11.0.3"
    },
    "source-map-js": "1.2.2",
    "next-auth": {
      "nodemailer": "10.1.4"
    },
    "@auth/core": {
      "nodemailer": "10.1.4"
    }
  }
