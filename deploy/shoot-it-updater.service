[Unit]
Description=Shoot-It release updater
Wants=network-online.target
After=network-online.target docker.service
Requires=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/shoot-it-updater.env
ExecStart=/usr/bin/python3 /usr/local/lib/shoot-it/update.py run
UMask=0077
TimeoutStartSec=3h
